{
    "name": "numerics-js",
    "version": "0.1.0",
    "description": "A TypeScript numerical methods library",
    "type": "module",
    "browser": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "browser": "./dist/index.js",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./array": {
            "types": "./dist/array.d.ts",
            "browser": "./dist/array.js",
            "import": "./dist/array.js",
            "default": "./dist/array.js"
        },
        "./special": {
            "types": "./dist/special.d.ts",
            "browser": "./dist/special.js",
            "import": "./dist/special.js",
            "default": "./dist/special.js"
        },
        "./special/bessel": {
            "types": "./dist/special/bessel.d.ts",
            "browser": "./dist/special/bessel.js",
            "import": "./dist/special/bessel.js",
            "default": "./dist/special/bessel.js"
        },
        "./math": {
            "types": "./dist/math.d.ts",
            "browser": "./dist/math.js",
            "import": "./dist/math.js",
            "default": "./dist/math.js"
        },
        "./roots": {
            "types": "./dist/roots.d.ts",
            "browser": "./dist/roots.js",
            "import": "./dist/roots.js",
            "default": "./dist/roots.js"
        },
        "./ode": {
            "types": "./dist/ode.d.ts",
            "browser": "./dist/ode.js",
            "import": "./dist/ode.js",
            "default": "./dist/ode.js"
        },
        "./ode/verlet": {
            "types": "./dist/ode/verlet.d.ts",
            "browser": "./dist/ode/verlet.js",
            "import": "./dist/ode/verlet.js",
            "default": "./dist/ode/verlet.js"
        },
        "./optimize": {
            "types": "./dist/optimize.d.ts",
            "browser": "./dist/optimize.js",
            "import": "./dist/optimize.js",
            "default": "./dist/optimize.js"
        },
        "./integrate": {
            "types": "./dist/integrate.d.ts",
            "browser": "./dist/integrate.js",
            "import": "./dist/integrate.js",
            "default": "./dist/integrate.js"
        },
        "./interpolate": {
            "types": "./dist/interpolate.d.ts",
            "browser": "./dist/interpolate.js",
            "import": "./dist/interpolate.js",
            "default": "./dist/interpolate.js"
        }
    },
    "scripts": {
        "clean": "node scripts/clean-dist.mjs",
        "lint": "eslint . --max-warnings 0",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/fix-esm-imports.mjs",
        "docs": "typedoc"
    },
    "keywords": [
        "numerical-methods",
        "mathematics",
        "algorithms",
        "javascript",
        "library"
    ],
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.2.0",
        "eslint": "^10.10.0",
        "typedoc": "^0.28.20",
        "typedoc-material-theme": "^1.4.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.42.0",
        "vitest": "^3.2.6"
    }
}