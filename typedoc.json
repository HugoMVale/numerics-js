{
    "$schema": "https://typedoc.org/schema.json",
    "entryPoints": [
        "src/array.ts",
        "src/roots.ts",
        "src/ode.ts",
        "src/special.ts",
        "src/misc.ts"
    ],
    "tsconfig": "tsconfig.build.json",
    "out": "docs",
    "readme": "README.md",
    "name": "numerics-js API",
    "plugin": [
        "typedoc-material-theme"
    ],
    "includeVersion": true,
    "excludeExternals": true,
    "excludeInternal": true,
    "excludePrivate": true,
    "excludeProtected": true,
    "intentionallyNotExported": [
        "ComputeAccelerationFn",
        "DP54Options",
        "DP54Scratch",
        "RK4Scratch",
        "StepFn"
    ]
}